generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model City {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  offices   Office[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Office {
  id          String   @id @default(cuid())
  cityId      String
  city        City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  name        String
  category    String
  area        String?
  address     String?
  hours       String?
  website     String?
  phone       String?
  notes       String?
  lastUpdated DateTime?

  requirements OfficeRequirement[]
  steps        OfficeStep[]
  fees         OfficeFee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cityId, category])
  @@index([name])
}

model OfficeRequirement {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  text     String
  position Int
  @@index([officeId, position])
}

model OfficeStep {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  text     String
  position Int
  @@index([officeId, position])
}

model OfficeFee {
  id       String @id @default(cuid())
  officeId String
  office   Office @relation(fields: [officeId], references: [id], onDelete: Cascade)
  text     String
  position Int
  @@index([officeId, position])
}